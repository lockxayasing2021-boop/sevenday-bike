<script>
const API_URL = 'https://script.google.com/macros/s/AKfycbyOcu6vlWUnvzRb4GTjEpxz5Amre1KhTYa7wU9PPjVlBd79B8XMzeJER_h-OLrHnxBboA/exec';
const API_SECRET = 'SDdMc3wNjJEevs60n2oMQeGnuI';
const ADMIN_TOKEN_KEY = 'sdAdminToken';

// ── HMAC ─────────────────────────────────────────────
async function hmacSign(body){
  const enc=new TextEncoder();
  const key=await crypto.subtle.importKey('raw',enc.encode(API_SECRET),{name:'HMAC',hash:'SHA-256'},false,['sign']);
  const sig=await crypto.subtle.sign('HMAC',key,enc.encode(body));
  return Array.from(new Uint8Array(sig)).map(b=>b.toString(16).padStart(2,'0')).join('');
}
async function post(action,data={}){
  const token=sessionStorage.getItem(ADMIN_TOKEN_KEY)||'';
  const body=JSON.stringify({action,...data,admin_token:token});
  const sig=await hmacSign(body);
  const res=await fetch(API_URL+'?sig='+sig,{method:'POST',headers:{'Content-Type':'application/json'},body});
  return JSON.parse(await res.text());
}
async function get(params){
  const token=sessionStorage.getItem(ADMIN_TOKEN_KEY)||'';
  const p={...params,admin_token:token};
  const qs=Object.entries(p).map(([k,v])=>k+'='+encodeURIComponent(v)).join('&');
  const sig=await hmacSign(qs);
  const res=await fetch(API_URL+'?'+qs+'&sig='+sig);
  return JSON.parse(await res.text());
}

// ── State ────────────────────────────────────────────
let eventId = null;
let allRegs = [];
let filteredRegs = [];
let currentPage = 1;
const PAGE_SIZE = 25;
let selectedIds = new Set();
let modalRegId = null;

// ── Boot ─────────────────────────────────────────────
(async function init(){
  const u = new URLSearchParams(location.search);
  eventId = u.get('event_id');
  if(!eventId){ document.getElementById('bar-event-name').textContent='ไม่พบ Event ID'; return; }
  // update checkin link
  document.getElementById('link-checkin').href = `admin-events-checkin.html?event_id=${encodeURIComponent(eventId)}`;
  await Promise.all([loadEvent(), loadRegistrations()]);
})();

async function loadEvent(){
  try{
    const r = await get({action:'evt.getEvent',event_id:eventId});
    if(r.success && r.event){
      const ev = r.event;
      document.getElementById('nav-event-name').textContent = ev.event_name||'—';
      document.getElementById('bar-event-name').textContent = ev.event_name||'—';
      let dateStr='—';
      if(ev.event_date){try{const d=new Date(ev.event_date);dateStr=d.toLocaleDateString('th-TH',{weekday:'short',day:'numeric',month:'short',year:'numeric'});}catch(e){dateStr=ev.event_date;}}
      document.getElementById('bar-date').textContent = '📅 '+dateStr;
      document.getElementById('bar-location').textContent = ev.location ? '📍 '+ev.location : '';
      const statusLabels={draft:'Draft',published:'Published',open:'เปิดรับสมัคร',closed:'ปิดรับสมัคร',completed:'เสร็จสิ้น'};
      const statusClasses={draft:'chip-draft',open:'chip-open',closed:'chip-closed',completed:'chip-closed'};
      document.getElementById('bar-status-chip').innerHTML =
        `<span class="status-chip ${statusClasses[ev.status]||'chip-draft'}">${statusLabels[ev.status]||ev.status}</span>`;
    }
  }catch(e){}
}

async function loadRegistrations(){
  try{
    const r = await get({action:'evt.getEventRegistrations',event_id:eventId});
    if(r.success && r.registrations){
      allRegs = r.registrations;
      updateStats();
      populateCategoryFilter();
      applyFilters();
    } else {
      document.getElementById('reg-tbody').innerHTML = '<tr class="loading-row"><td colspan="11">ไม่พบข้อมูล</td></tr>';
    }
  }catch(e){
    document.getElementById('reg-tbody').innerHTML = '<tr class="loading-row"><td colspan="11">เกิดข้อผิดพลาดในการโหลดข้อมูล</td></tr>';
  }
}

// ── Stats ─────────────────────────────────────────────
function updateStats(){
  const total = allRegs.length;
  const pending = allRegs.filter(r=>r.status==='pending').length;
  const paid = allRegs.filter(r=>r.status==='paid').length;
  const approved = allRegs.filter(r=>r.status==='approved').length;
  const revenue = allRegs.filter(r=>r.status==='approved').reduce((s,r)=>s+(r.total_amount||0),0);
  document.getElementById('st-total').textContent = total;
  document.getElementById('st-pending').textContent = pending;
  document.getElementById('st-paid').textContent = paid;
  document.getElementById('st-approved').textContent = approved;
  document.getElementById('st-revenue').textContent = revenue.toLocaleString('th-TH');
}

function populateCategoryFilter(){
  const cats = [...new Set(allRegs.flatMap(r=>(r.participants||[]).map(p=>p.category_name)).filter(Boolean))];
  const sel = document.getElementById('filter-category');
  cats.forEach(c=>{
    const o=document.createElement('option'); o.value=c; o.textContent=c; sel.appendChild(o);
  });
}

// ── Filter + paginate ─────────────────────────────────
function applyFilters(){
  const q = document.getElementById('search-inp').value.toLowerCase().trim();
  const st = document.getElementById('filter-status').value;
  const cat = document.getElementById('filter-category').value;

  filteredRegs = allRegs.filter(r=>{
    if(st && r.status!==st) return false;
    if(cat){
      const hasCat = (r.participants||[]).some(p=>p.category_name===cat);
      if(!hasCat) return false;
    }
    if(q){
      const hay = [r.reg_id,r.contact_email,r.contact_phone,
        ...(r.participants||[]).map(p=>p.first_name+' '+p.last_name)].join(' ').toLowerCase();
      if(!hay.includes(q)) return false;
    }
    return true;
  });

  currentPage=1;
  selectedIds.clear();
  document.getElementById('check-all').checked=false;
  renderTable();
  updateBulkBar();
}

function renderTable(){
  const start=(currentPage-1)*PAGE_SIZE;
  const page=filteredRegs.slice(start,start+PAGE_SIZE);
  const tbody=document.getElementById('reg-tbody');

  if(page.length===0){
    tbody.innerHTML='<tr class="loading-row"><td colspan="11">ไม่พบข้อมูล</td></tr>';
    document.getElementById('pagination').style.display='none';
    return;
  }

  tbody.innerHTML = page.map(reg=>buildRow(reg)).join('');

  // pagination
  const totalPages = Math.ceil(filteredRegs.length/PAGE_SIZE);
  if(totalPages>1){
    document.getElementById('pagination').style.display='flex';
    document.getElementById('page-info').textContent =
      `หน้า ${currentPage}/${totalPages} (${filteredRegs.length} รายการ)`;
    document.getElementById('btn-prev').disabled = currentPage===1;
    document.getElementById('btn-next').disabled = currentPage===totalPages;
  } else {
    document.getElementById('pagination').style.display='none';
  }
}

function changePage(d){
  const totalPages=Math.ceil(filteredRegs.length/PAGE_SIZE);
  currentPage=Math.max(1,Math.min(totalPages,currentPage+d));
  renderTable();
}

function buildRow(reg){
  const badgeCls='b-'+(reg.status||'pending');
  const statusLabel={pending:'รอชำระ',paid:'ชำระแล้ว',approved:'อนุมัติ',rejected:'ปฏิเเสธ',cancelled:'ยกเลิก'}[reg.status]||reg.status;

  // Participants summary
  const cats=[...new Set((reg.participants||[]).map(p=>p.category_name).filter(Boolean))];
  const catStr=cats.slice(0,2).map(escHtml).join(', ')+(cats.length>2?' +'+( cats.length-2):'');

  // BIBs
  const bibs=(reg.participants||[]).map(p=>p.bib_number).filter(Boolean);
  const bibHtml=bibs.length>0?bibs.map(b=>`<span class="bib-badge">${escHtml(String(b))}</span>`).join(' '):
    `<span class="bib-none">รอ BIB</span>`;

  // Slip
  const hasSlip=!!(reg.slip_image_url||reg.slip_base64);
  const slipHtml=hasSlip?
    `<img class="slip-thumb" src="${reg.slip_image_url||('data:image/jpeg;base64,'+reg.slip_base64)}" alt="slip" onclick="openModal('${escAttr(reg.reg_id)}',event)">`
    :`<div class="no-slip">—</div>`;

  // Date
  let dateStr='—';
  if(reg.created_at){try{const d=new Date(reg.created_at);dateStr=d.toLocaleDateString('th-TH',{day:'2-digit',month:'2-digit',year:'2-digit'});}catch(e){}}

  const pCount=(reg.participants||[]).length||1;

  // Row actions
  let actions='';
  if(reg.status==='paid'){
    actions=`<button class="row-btn approve" onclick="quickAction('${escAttr(reg.reg_id)}','approved',event)">✓ อนุมัติ</button><button class="row-btn reject" onclick="quickAction('${escAttr(reg.reg_id)}','rejected',event)">✗</button>`;
  } else if(reg.status==='pending'){
    actions=`<button class="row-btn" onclick="openModal('${escAttr(reg.reg_id)}',event)">ดู Slip</button>`;
  } else if(reg.status==='approved'){
    actions=`<button class="row-btn reject" onclick="quickAction('${escAttr(reg.reg_id)}','rejected',event)">เพิกถอน</button>`;
  } else {
    actions=`<button class="row-btn" onclick="quickAction('${escAttr(reg.reg_id)}','pending',event)">รีเซ็ต</button>`;
  }

  const checked=selectedIds.has(reg.reg_id)?'checked':'';
  return `
  <tr id="row-${escAttr(reg.reg_id)}" class="${selectedIds.has(reg.reg_id)?'selected':''}">
    <td class="check-cell"><input type="checkbox" ${checked} onchange="toggleRow('${escAttr(reg.reg_id)}',this)"></td>
    <td><span style="font-weight:800;font-size:12px">${escHtml(reg.reg_id||'—')}</span></td>
    <td>
      <div style="font-weight:700">${escHtml((reg.participants&&reg.participants[0])?reg.participants[0].first_name+' '+reg.participants[0].last_name:'—')}</div>
      <div style="font-size:11px;color:var(--g6)">${escHtml(reg.contact_email||reg.contact_phone||'')}</div>
    </td>
    <td style="font-size:12px;color:var(--g6)">${catStr||'—'}</td>
    <td style="text-align:center;font-weight:700">${pCount}</td>
    <td>${bibHtml}</td>
    <td style="font-weight:800;font-variant-numeric:tabular-nums">${(reg.total_amount||0).toLocaleString('th-TH')}</td>
    <td>${slipHtml}</td>
    <td><span class="badge ${badgeCls}">${statusLabel}</span></td>
    <td style="color:var(--g6);font-size:12px">${dateStr}</td>
    <td><div class="row-actions">${actions}</div></td>
  </tr>`;
}

// ── Checkbox selection ────────────────────────────────
function toggleAll(cb){
  const start=(currentPage-1)*PAGE_SIZE;
  const page=filteredRegs.slice(start,start+PAGE_SIZE);
  page.forEach(r=>{ if(cb.checked) selectedIds.add(r.reg_id); else selectedIds.delete(r.reg_id); });
  renderTable();
  updateBulkBar();
}
function toggleRow(id,cb){
  if(cb.checked) selectedIds.add(id); else selectedIds.delete(id);
  const row=document.getElementById('row-'+id);
  if(row) row.classList.toggle('selected',cb.checked);
  updateBulkBar();
}
function updateBulkBar(){
  const n=selectedIds.size;
  const el=document.getElementById('bulk-count');
  el.textContent=`เลือก ${n} รายการ`;
  el.classList.toggle('show',n>0);
  document.getElementById('btn-bulk-approve').disabled=n===0;
  document.getElementById('btn-bulk-reject').disabled=n===0;
}

// ── Quick row action ──────────────────────────────────
async function quickAction(regId, newStatus, ev){
  if(ev){ ev.stopPropagation(); }
  await updateStatus(regId, newStatus);
}

// ── Bulk action ───────────────────────────────────────
async function bulkAction(newStatus){
  if(selectedIds.size===0) return;
  const ids=[...selectedIds];
  const label=newStatus==='approved'?'อนุมัติ':'ปฏิเสธ';
  if(!confirm(`${label} ${ids.length} รายการที่เลือก?`)) return;
  showToast('กำลังดำเนินการ…',3000);
  let ok=0;
  for(const id of ids){
    const r=await updateStatusSilent(id,newStatus);
    if(r) ok++;
  }
  selectedIds.clear();
  showToast(`${label}สำเร็จ ${ok}/${ids.length} รายการ`);
  await loadRegistrations();
}

// ── Update status ─────────────────────────────────────
async function updateStatus(regId, newStatus, note=''){
  try{
    const r=await post('evt.updateRegistrationStatus',{reg_id:regId,status:newStatus,note});
    if(r.success){
      // update local
      const reg=allRegs.find(x=>x.reg_id===regId);
      if(reg){ reg.status=newStatus; if(r.participants) reg.participants=r.participants; }
      updateStats(); applyFilters(); closeModal();
      showToast(newStatus==='approved'?'อนุมัติแล้ว ✓':newStatus==='rejected'?'ปฏิเสธแล้ว':newStatus==='paid'?'ตั้งเป็น รอตรวจสอบ':'อัปเดตแล้ว');
      return true;
    } else { showToast('เกิดข้อผิดพลาด: '+(r.error||''),3500); return false; }
  }catch(e){ showToast('เกิดข้อผิดพลาด',3000); return false; }
}
async function updateStatusSilent(regId,newStatus){
  try{
    const r=await post('evt.updateRegistrationStatus',{reg_id:regId,status:newStatus});
    if(r.success){ const reg=allRegs.find(x=>x.reg_id===regId); if(reg) reg.status=newStatus; return true; }
  }catch(e){}
  return false;
}

// ── Modal ─────────────────────────────────────────────
function openModal(regId, ev){
  if(ev) ev.stopPropagation();
  const reg = allRegs.find(r=>r.reg_id===regId);
  if(!reg) return;
  modalRegId = regId;

  document.getElementById('modal-title').textContent = 'ตรวจสอบ – '+regId;
  document.getElementById('reject-reason-box').style.display='none';
  document.getElementById('reject-reason-text').value='';

  // slip image
  const imgEl=document.getElementById('modal-slip-img');
  const noSlipEl=document.getElementById('modal-no-slip');
  const slipSrc=reg.slip_image_url||(reg.slip_base64?'data:image/jpeg;base64,'+reg.slip_base64:'');
  if(slipSrc){ imgEl.src=slipSrc; imgEl.style.display='block'; noSlipEl.style.display='none'; }
  else { imgEl.style.display='none'; noSlipEl.style.display='block'; }

  // reg info grid
  let dateStr='—';
  if(reg.created_at){try{const d=new Date(reg.created_at);dateStr=d.toLocaleDateString('th-TH',{day:'numeric',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'});}catch(e){}}
  const pCount=(reg.participants||[]).length||1;
  const cats=[...new Set((reg.participants||[]).map(p=>p.category_name).filter(Boolean))].join(', ');
  const statusLabel={pending:'รอชำระ',paid:'ชำระแล้ว (รอตรวจ)',approved:'อนุมัติแล้ว',rejected:'ปฏิเสธ',cancelled:'ยกเลิก'}[reg.status]||reg.status;

  document.getElementById('modal-reg-info').innerHTML=`
    <div class="mri-item"><label>Reg ID</label><span>${escHtml(reg.reg_id)}</span></div>
    <div class="mri-item"><label>สถานะ</label><span class="badge b-${reg.status||'pending'}">${statusLabel}</span></div>
    <div class="mri-item"><label>ผู้ติดต่อ</label><span>${escHtml(reg.contact_email||reg.contact_phone||'—')}</span></div>
    <div class="mri-item"><label>ยอดรวม</label><span style="font-size:16px;font-weight:900">${(reg.total_amount||0).toLocaleString('th-TH')} ₭</span></div>
    <div class="mri-item"><label>จำนวนคน</label><span>${pCount} คน</span></div>
    <div class="mri-item"><label>หมวดหมู่</label><span>${escHtml(cats||'—')}</span></div>
    <div class="mri-item" style="grid-column:span 2"><label>วันที่สมัคร</label><span>${dateStr}</span></div>
    ${reg.payment_note?`<div class="mri-item" style="grid-column:span 2"><label>หมายเหตุการชำระ</label><span>${escHtml(reg.payment_note)}</span></div>`:''}
  `;

  document.getElementById('modal-slip').classList.add('open');
}
function closeModal(ev){
  if(ev && ev.target!==document.getElementById('modal-slip')) return;
  document.getElementById('modal-slip').classList.remove('open');
  modalRegId=null;
}
function showRejectReason(){
  const box=document.getElementById('reject-reason-box');
  box.style.display=box.style.display==='none'?'block':'none';
}
async function modalAction(status){
  if(!modalRegId) return;
  const note=status==='rejected'?document.getElementById('reject-reason-text').value.trim():'';
  await updateStatus(modalRegId,status,note);
}

// ── Export CSV ────────────────────────────────────────
function exportCSV(){
  const rows=[['Reg ID','สถานะ','ชื่อผู้ติดต่อ','อีเมล','โทร','หมวดหมู่','จำนวนคน','BIB','ยอดรวม','วันที่สมัคร']];
  allRegs.forEach(r=>{
    const cats=[...new Set((r.participants||[]).map(p=>p.category_name).filter(Boolean))].join(';');
    const bibs=(r.participants||[]).map(p=>p.bib_number).filter(Boolean).join(';');
    const pCount=(r.participants||[]).length||1;
    rows.push([r.reg_id,r.status,
      (r.participants&&r.participants[0])?r.participants[0].first_name+' '+r.participants[0].last_name:'',
      r.contact_email||'',r.contact_phone||'',cats,pCount,bibs,r.total_amount||0,r.created_at||'']);
  });
  const csv=rows.map(r=>r.map(c=>'"'+String(c).replace(/"/g,'""')+'"').join(',')).join('\n');
  const blob=new Blob(['﻿'+csv],{type:'text/csv;charset=utf-8'});
  const url=URL.createObjectURL(blob);
  const a=document.createElement('a');
  a.href=url; a.download=`registrations_${eventId}_${new Date().toISOString().slice(0,10)}.csv`;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(url);
  showToast('ดาวน์โหลด CSV แล้ว');
}

// ── Toast ─────────────────────────────────────────────
let toastTimer=null;
function showToast(msg,dur=2500){
  const el=document.getElementById('toast');
  el.textContent=msg; el.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>el.classList.remove('show'),dur);
}

// ── Utils ─────────────────────────────────────────────
function escHtml(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function escAttr(s){ return String(s).replace(/'/g,"\\'"); }

// keyboard
document.addEventListener('keydown',e=>{ if(e.key==='Escape') closeModal(); });
</script>
